# Reference for hosting environment variables, not automatically loaded by NODE_ENV.
# Supply via the hosting dashboard/process manager, or a local .env for an isolated staging run.
NODE_ENV=production
PORT=3000
API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ADMIN_SESSION_SECRET=
REDIS_URL=
LOOPY_DATABASE_KIND=production
ENABLE_DEV_LOGIN=false
SWAGGER_ENABLED=false
SWAGGER_REQUIRE_AUTH=true
SWAGGER_INCLUDE_DEBUG=false
# Optional providers. Without a runner, only JavaScript executes; check /api/execute/capabilities.
PISTON_API_URL=
PISTON_API_KEY=
GLOT_API_TOKEN=
GLOT_ENABLED=false
GLOT_API_URL=https://glot.io/api/mux
GROQ_API_KEY=
GEMINI_API_KEY=
